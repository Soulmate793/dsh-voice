{
  "name": "dsh-voice",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "IndexTTS2 voice plugin for DeepSeek Harness with emotion tone profiles, PSOLA pitch contour, mood-driven speech, and QQ delivery",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tts",
    "voice",
    "indextts2",
    "emotion",
    "emotion-simulation",
    "onebot",
    "snowluma"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "runtime/say.mjs",
    "runtime/pitch_contour.py",
    "runtime/indextts2_server.py",
    "runtime/emotion.mjs",
    "runtime/datadir.mjs",
    "runtime/config.example.json",
    "runtime/config.full.example.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}